# The anon key is safe to expose in browser code — RLS is what actually
# gates access. Do not commit a real .env.local with these filled in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Defaults to http://localhost:3001 if unset — only needed to point at a
# non-default API URL.
NEXT_PUBLIC_API_URL=

# Local UI only — skip the app auth gate and optionally load gitignored mocks
# from apps/web/lib/devBypass.local.ts. Never enable in production.
# NEXT_PUBLIC_DEV_BYPASS_AUTH=1
