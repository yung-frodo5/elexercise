# Used by SupabaseWorkoutRepository and the auth middleware. The service-role
# key is a server-side secret — it bypasses RLS, so never expose it to a
# client app. The anon key is safe to expose (it's what the middleware uses
# to verify inbound JWTs). Do not commit a real .env with these filled in.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGIN=
